generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Core ----------

model Branch {
  id      String @id @default(cuid())
  name    String
  address String
  city    String
  phone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  stockLevels  StockLevel[]
  salesOrders  SalesOrder[]
  productUnits ProductUnit[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean @default(true)

  // Per-account permission overrides — meaningful for Supervisor accounts, whose access is
  // composed by an Admin at creation time rather than inherited from a shared role. Admin
  // accounts always get full access regardless of this field (see JwtStrategy).
  permissions String[] @default([])

  roleId   String
  role     Role    @relation(fields: [roleId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads         Lead[]          @relation("LeadAssignee")
  ownedB2BAccounts      B2BAccount[]    @relation("B2BAccountOwner")
  ownedOpportunities    Opportunity[]   @relation("OpportunityOwner")
  loggedInteractions    Interaction[]   @relation("InteractionCreatedBy")
  assignedServiceTickets ServiceTicket[] @relation("ServiceTicketAssignee")
  createdQuotes         Quote[]         @relation("QuoteCreatedBy")
  createdSalesOrders    SalesOrder[]    @relation("SalesOrderCreatedBy")
  recordedPayments      Payment[]       @relation("PaymentRecordedBy")
}

// ---------- Inventory ----------

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

model Brand {
  id      String  @id @default(cuid())
  name    String  @unique
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id           String        @id @default(cuid())
  sku          String        @unique
  name         String
  brandId      String
  brand        Brand         @relation(fields: [brandId], references: [id])
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  modelNumber  String?
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  specs        Json?
  images       String[]
  features     String[]      @default([])
  manualUrl    String?
  status       ProductStatus @default(ACTIVE)

  // GST — snapshotted onto each QuoteItem at quote time, so a later rate change here doesn't
  // rewrite the tax on quotes already issued.
  hsnCode String?
  gstRate Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels     StockLevel[]
  productUnits    ProductUnit[]
  quoteItems      QuoteItem[]
  salesOrderItems SalesOrderItem[]
  socialPosts     SocialPost[]
  productReviews  ProductReview[]
}

model StockLevel {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  quantity  Int     @default(0)

  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
}

enum ProductUnitStatus {
  IN_STOCK
  SOLD
  RETURNED
}

model ProductUnit {
  id           String            @id @default(cuid())
  serialNumber String            @unique
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  status       ProductUnitStatus @default(IN_STOCK)

  soldAt            DateTime?
  warrantyExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceTickets ServiceTicket[]
  productReview  ProductReview?
}

// ---------- CRM ----------

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?
  address      String?
  loyaltyPoints Int     @default(0)
  source       String?

  // GST — `address` above is the billing address; shippingAddress falls back to it when blank.
  gstin           String?
  state           String?
  shippingAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads          Lead[]
  productUnits   ProductUnit[]
  interactions   Interaction[]
  serviceTickets ServiceTicket[]
  quotes         Quote[]
  salesOrders    SalesOrder[]
  productReviews ProductReview[]
}

/**
 * Tracks the WhatsApp bot's post-purchase check-in for a specific ProductUnit — created the
 * first time a customer messages back after that purchase (REQUESTED), then updated with their
 * reply (RECEIVED). One review per purchased unit (see @@unique below) is what makes "only ask
 * once per purchase" work: its mere existence is the flag that the check-in already happened.
 */
enum ReviewRequestStatus {
  REQUESTED
  RECEIVED
}

model ProductReview {
  id            String              @id @default(cuid())
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id])
  productId     String
  product       Product             @relation(fields: [productId], references: [id])
  productUnitId String              @unique
  productUnit   ProductUnit         @relation(fields: [productUnitId], references: [id])
  status        ReviewRequestStatus @default(REQUESTED)
  rating        Int?
  comment       String?

  requestedAt DateTime  @default(now())
  respondedAt DateTime?
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

model Lead {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  source     String?
  stage      LeadStage @default(NEW)
  notes      String?

  nextFollowUpAt DateTime?

  assignedToId String
  assignedTo   User   @relation("LeadAssignee", fields: [assignedToId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]
  quotes       Quote[]
}

enum B2BAccountType {
  ARCHITECT
  INTERIOR_DESIGNER
  BUILDER
  DEVELOPER
}

model B2BAccount {
  id      String         @id @default(cuid())
  name    String
  type    B2BAccountType
  address String?

  // GST — `address` above is the billing address; shippingAddress falls back to it when blank.
  gstin           String?
  state           String?
  shippingAddress String?

  ownerId String
  owner   User   @relation("B2BAccountOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      B2BContact[]
  opportunities Opportunity[]
  interactions  Interaction[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
}

model B2BContact {
  id           String @id @default(cuid())
  b2bAccountId String
  b2bAccount   B2BAccount @relation(fields: [b2bAccountId], references: [id])
  name         String
  role         String?
  phone        String?
  email        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OpportunityStage {
  CONSULTATION
  DESIGN_SUPPORT
  PRODUCT_SELECTION
  INSTALLATION
  AFTER_SALES
  LOST
}

model Opportunity {
  id    String @id @default(cuid())
  title String

  b2bAccountId String
  b2bAccount   B2BAccount @relation(fields: [b2bAccountId], references: [id])

  stage             OpportunityStage @default(CONSULTATION)
  estimatedValue     Decimal?        @db.Decimal(12, 2)
  expectedCloseDate  DateTime?

  ownerId String
  owner   User   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]
  quotes       Quote[]
}

enum InteractionType {
  CALL
  MEETING
  NOTE
  EMAIL
  WHATSAPP
  OTHER
}

model Interaction {
  id      String          @id @default(cuid())
  type    InteractionType
  subject String?
  body    String?

  occurredAt DateTime @default(now())

  createdById String
  createdBy   User   @relation("InteractionCreatedBy", fields: [createdById], references: [id])

  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  b2bAccountId  String?
  b2bAccount    B2BAccount?  @relation(fields: [b2bAccountId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  createdAt DateTime @default(now())
}

enum ServiceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ServiceTicket {
  id               String              @id @default(cuid())
  productUnitId    String
  productUnit      ProductUnit         @relation(fields: [productUnitId], references: [id])
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  status           ServiceTicketStatus @default(OPEN)
  issueDescription String
  resolutionNotes  String?

  assignedToId String?
  assignedTo   User?   @relation("ServiceTicketAssignee", fields: [assignedToId], references: [id])

  scheduledAt DateTime?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Sales ----------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)

  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  b2bAccountId  String?
  b2bAccount    B2BAccount?  @relation(fields: [b2bAccountId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  // GST — cgst/sgst apply when placeOfSupplyState matches the business's own state (see
  // CompanySettings), otherwise igst applies. roundingAdjustment is the delta between the raw
  // computed total and the rupee-rounded total actually billed.
  quoteDate          DateTime @default(now())
  validUntil         DateTime?
  placeOfSupplyState String?
  shippingAddress    String?
  notes              String?
  termsAndConditions String?
  // Visual layout for the printed/PDF document — see apps/web/src/lib/quote-templates.ts.
  templateId         String   @default("standard")
  cgstTotal          Decimal  @default(0) @db.Decimal(12, 2)
  sgstTotal          Decimal  @default(0) @db.Decimal(12, 2)
  igstTotal          Decimal  @default(0) @db.Decimal(12, 2)
  roundingAdjustment Decimal  @default(0) @db.Decimal(12, 2)

  createdById String
  createdBy   User   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      QuoteItem[]
  salesOrder SalesOrder?
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)

  // Snapshotted from the Product at quote time — see the note on Product.gstRate.
  hsnCode     String?
  gstRate     Decimal? @db.Decimal(5, 2)
  cgstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount  Decimal  @default(0) @db.Decimal(12, 2)
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  status      SalesOrderStatus @default(PENDING)

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  b2bAccountId String?
  b2bAccount   B2BAccount? @relation(fields: [b2bAccountId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  // Copied from the source Quote at confirmation time, same snapshot reasoning as QuoteItem.hsnCode/gstRate.
  placeOfSupplyState String?
  shippingAddress    String?
  notes              String?
  termsAndConditions String?
  cgstTotal          Decimal @default(0) @db.Decimal(12, 2)
  sgstTotal          Decimal @default(0) @db.Decimal(12, 2)
  igstTotal          Decimal @default(0) @db.Decimal(12, 2)
  roundingAdjustment Decimal @default(0) @db.Decimal(12, 2)

  createdById String
  createdBy   User   @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        SalesOrderItem[]
  productUnits ProductUnit[]
  invoice      Invoice?
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0) @db.Decimal(12, 2)

  hsnCode    String?
  gstRate    Decimal? @db.Decimal(5, 2)
  cgstAmount Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount Decimal  @default(0) @db.Decimal(12, 2)
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  salesOrderId  String        @unique
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
}

// ---------- Settings / Integrations ----------

enum IntegrationProvider {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  AI_IMAGE
}

// configEncrypted holds a provider-specific JSON payload (access tokens, phone/account IDs)
// encrypted at rest with AES-256-GCM — never stored or returned in plaintext.
model IntegrationSetting {
  id              String              @id @default(cuid())
  provider        IntegrationProvider @unique
  configEncrypted String
  isActive        Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (fixed id "default") for public-website settings an Admin may need to change
// without a code deploy — starting with the showroom's Google Maps link, in case the business
// ever relocates.
model SiteSettings {
  id      String  @id @default("default")
  mapsUrl String?

  updatedAt DateTime @updatedAt
}

// Singleton row (fixed id "default") for the business's own GST/billing identity — printed as
// the "From" details on every quote. Deliberately separate from SiteSettings above (which is
// public-website-facing): this holds bank account details and must never be exposed via a
// public endpoint. Admin-only, filled in by the business itself — never fabricated.
model CompanySettings {
  id        String  @id @default("default")
  legalName String?
  gstin     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?

  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  bankBranch        String?

  defaultTermsAndConditions String?
  defaultNotes               String?

  updatedAt DateTime @updatedAt
}

// ---------- Social Media Automation ----------

enum SocialPostStatus {
  PENDING_REVIEW
  POSTED
  DISCARDED
}

// One review candidate at a time per the daily generation flow: a fresh generate/regenerate
// marks any prior PENDING_REVIEW post for the same cycle as DISCARDED.
model SocialPost {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  caption   String
  imagePath String
  status    SocialPostStatus @default(PENDING_REVIEW)

  postedToInstagramAt DateTime?
  postedToFacebookAt  DateTime?
  instagramError      String?
  facebookError       String?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
