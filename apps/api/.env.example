NODE_ENV="development"
DATABASE_URL="postgresql://dreamhome:dreamhome@localhost:5433/dreamhome?schema=public"
# openssl rand -hex 32 (32+ chars, required)
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
PORT=3001
# openssl rand -hex 32 (exactly 64 hex chars — AES-256 key)
INTEGRATIONS_ENCRYPTION_KEY="generate-a-32-byte-hex-key"
WHATSAPP_WEBHOOK_URL="http://localhost:3001/webhooks/whatsapp"
PUBLIC_API_URL="http://localhost:3001"
# Comma-separated list of allowed frontend origins. Empty/unset = allow-all in dev, deny-all
# in production (NODE_ENV=production).
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"
# Only consulted by `prisma db seed`. Required when NODE_ENV=production — seeding refuses to
# run without it rather than creating the default admin123 password.
# ADMIN_EMAIL="admin@yourdomain.com"
# ADMIN_PASSWORD=""
